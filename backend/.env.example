# --- AI provider ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Security ---
# Long random string used to sign staff login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me
TOKEN_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Any localhost port is also allowed by default for development.
# Set CORS_ORIGIN_REGEX= (empty) in production to allow only CORS_ORIGINS.

# Demo staff accounts (created on first start only). Change these!
ADMIN_EMAIL=admin@supportpilot.dev
ADMIN_PASSWORD=admin123
AGENT_EMAIL=agent@supportpilot.dev
AGENT_PASSWORD=agent123

# --- Privacy ---
# Replace emails, phones, cards, IBANs and national IDs with placeholders
# before messages are stored or sent to the LLM.
PII_MASKING=true
# Permanently redact personal data found in uploaded knowledge documents.
REDACT_DOCUMENTS=true
# Conversations inactive for longer than this are deleted automatically.
RETENTION_DAYS=30

# --- Database ---
# All data is kept in this SQLite file. Back it up regularly.
DATABASE_URL=sqlite:///./supportpilot.db

# --- Hosting ---
# Where your team opens the dashboard. Used for links in alert emails.
PUBLIC_APP_URL=http://localhost:5173
# Where the search index and uploaded documents are stored.
DATA_DIR=.
UPLOAD_DIR=uploads

# Store connection (Shopify) and email alerts are set up
# from Settings in the dashboard, not in this file.

# --- Other ---
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=10
